session_start();

// ==================== Configuration ====================
define('PASSWORD', '#R4h4s[1a85$C0l3\K!!++'); // Change this password
define('SESSION_KEY', 'file_manager_session');

// ==================== Authentication ====================
function checkAuth() {
    if (!isset($_SESSION[SESSION_KEY]) || $_SESSION[SESSION_KEY] !== true) {
        if (isset($_POST['password']) && $_POST['password'] === PASSWORD) {
            $_SESSION[SESSION_KEY] = true;
            header('Location: ' . $_SERVER['PHP_SELF']);
            exit;
        }
        return false;
    }
    return true;
}

